FROM oven/bun:1

WORKDIR /app

# Dependencies are baked into the image and copied into the node_modules
# volume on first start; source is bind-mounted over /app by compose.
COPY package.json bun.lock ./
RUN bun install --frozen-lockfile

EXPOSE 3000

CMD ["bun", "--bun", "next", "dev", "--hostname", "0.0.0.0", "--port", "3000"]
